# ------------------------------------------------------------------
# Variables d'environnement — à définir dans Vercel (Settings → Environment Variables).
# Ne jamais préfixer une clé secrète par NEXT_PUBLIC_ : elle serait envoyée au navigateur.
# ------------------------------------------------------------------

# URL publique du site (facultatif). Vide ou absente : domaine de production Vercel.
NEXT_PUBLIC_SITE_URL=

# Envoi des demandes (commande de gâteau, message) — SECRETS, serveur uniquement.
RESEND_API_KEY=
# Adresse de la boutique qui reçoit les demandes.
CONTACT_TO_EMAIL=
# Expéditeur sur un domaine vérifié chez Resend, ex. « Site Aux Merveilles <site@domaine.fr> ».
CONTACT_FROM_EMAIL=

# Anti-spam Cloudflare Turnstile — OPTIONNEL, à n'activer qu'en cas de spam.
# (Sans JavaScript, le formulaire ne peut plus être envoyé quand Turnstile est actif.)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
